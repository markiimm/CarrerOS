# =============================================================================
# CareerOS — variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para `.env.local` e preencha. NUNCA versione o arquivo preenchido.
# Apenas as variáveis com prefixo NEXT_PUBLIC_ são expostas ao navegador.
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
# Obrigatórias. Expostas ao cliente (a anon key é protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OBRIGATÓRIA e SECRETA. Ignora RLS.
# Usada SOMENTE em lib/db/service.ts, importada apenas por app/api/cron/** e lib/radar/**.
# Jamais em arquivo com "use client". Jamais com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Inteligência artificial ─────────────────────────────────────────────────
# Obrigatória a partir da Fase 3. Somente servidor.
ANTHROPIC_API_KEY=

# AI_MOCK=1 devolve respostas de fixture, sem chamar o provedor nem gerar custo.
# Padrão recomendado: 1 em local e preview, 0 em produção.
AI_MOCK=1

# Teto global de segurança, em dólares, somado a todos os usuários no mês.
# Rede de proteção acima do teto individual de user_limits.
AI_GLOBAL_MONTHLY_CAP_USD=50

# ─── Agendamento ─────────────────────────────────────────────────────────────
# Obrigatória em produção. Segredo compartilhado das rotas /api/cron/**,
# comparado em tempo constante. Gere com: openssl rand -hex 32
CRON_SECRET=

# ─── Criptografia e hashing ──────────────────────────────────────────────────
# Obrigatória a partir da Fase 5. Cifra as chaves de API do usuário
# (integration_credentials). AES-256-GCM — 32 bytes em hex.
# Gere com: openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# Sal para o hash de IP em audit_logs. O IP em claro nunca é persistido.
# Gere com: openssl rand -hex 16
LOG_SALT=

# ─── Aplicação ───────────────────────────────────────────────────────────────
# URL pública, usada em links de e-mail e no callback de autenticação.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# development | preview | production
APP_ENV=development

# ─── E-mail transacional (Fase 5) ────────────────────────────────────────────
# Nas Fases 1–4 usa-se o SMTP padrão do Supabase e estas ficam vazias.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM="CareerOS <nao-responda@exemplo.com>"

# Remetente e prefixo de assunto usados quando o modo discreto está ativo (RN-092).
# Devem ser neutros: nada que revele busca de emprego.
MAIL_FROM_STEALTH="Painel <nao-responda@exemplo.com>"
MAIL_SUBJECT_PREFIX_STEALTH="[Painel]"

# ─── Coletor ─────────────────────────────────────────────────────────────────
# Orçamento de tempo por execução do runner, em ms. Deve ficar abaixo do limite
# da função serverless (60000 no plano Hobby, 300000 no Pro) — ADR-003.
COLLECTOR_RUN_BUDGET_MS=45000

# Timeout de cada requisição a fonte externa, em ms.
COLLECTOR_HTTP_TIMEOUT_MS=15000

# User-Agent das requisições de coleta. Deve identificar um cliente automatizado
# genérico. NÃO inclua nome, e-mail ou qualquer dado pessoal do usuário.
COLLECTOR_USER_AGENT="CareerOS/1.0 (+automated job feed reader)"

# ─── Observabilidade (opcional) ──────────────────────────────────────────────
LOG_LEVEL=info
# SENTRY_DSN=

# =============================================================================
# Verificação antes de ir a produção
# -----------------------------------------------------------------------------
#  [ ] SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, CRON_SECRET,
#      CREDENTIALS_ENC_KEY e LOG_SALT definidos e distintos dos de desenvolvimento.
#  [ ] AI_MOCK=0
#  [ ] APP_ENV=production e NEXT_PUBLIC_APP_URL com o domínio real
#  [ ] Nenhum segredo com prefixo NEXT_PUBLIC_
#  [ ] `grep -rn "NEXT_PUBLIC_" app features lib` retorna apenas SUPABASE_URL, ANON_KEY e APP_URL
#  [ ] `grep -rn "SERVICE_ROLE" app features lib` retorna apenas lib/db/service.ts
# =============================================================================
